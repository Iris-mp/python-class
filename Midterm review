def hallow_square(n):
    result = ""
    for row in range(1 , n + 1):
        if row == 1 or row == n:
            result += "*" * n
        else:
            result += "*" + " " * (n - 2) + "*"
        result += "\n"
    return result
print(hallow_square(5))

print()

def num_pattern(n):
    result = ""
    for row in range(1 , n + 1):
        number = 1
        while number <= row:
            result += str(number)
            number += 1
        if row < n:
            result += "\n"
    return result
print(num_pattern(5))

print()

def sum_pattern(n):
    formula = ""
    number = 0
    for num in range(1, n + 1):
        number += num
        formula += str(num)
        if num < n:
            formula += " + "
    return "Sum = " + str(formula) + " = " + str(number)
print(sum_pattern(5))

print()

def pyramid(n):
    result = ""
    for row in range(1, n+1):
        space = " " * (n-row)
        result += space + "*" * ((2*row)-1)
        result += "\n"
    return result
print(pyramid(4))

print()

n=int(input("Enter a number: "))
def fibonacci(n):
    if n == 0:
        return 0
    elif n == 1:
        return 1
    else:
        return fibonacci(n-1) + fibonacci(n-2)

print("F(", n , ") = ", fibonacci(n))

print()

def number_waterfall(n):
    for row in range(1, n+1):
        for num in range(1, n+2-row):
            print(num, end="")
        print()
print(number_waterfall(5))

print()

def factorial(n):
    result = 1
    for i in range(1, n+1):
        result *= i
    return result
print(str(n)+"! = ", factorial(5))

def add_factorial(n):
    result = 1
    formula = ""
    for i in range(1, n+1):
        result *= i
        formula += str(i)
        if i < n:
            formula += " * "
    return str(n)+"! = "+ str(formula) + " = "+ str(result)
print(add_factorial(5))

def backward_factorial(n):
    result = 1
    formula = ""
    for i in range(n, 0, -1):
        result *= i
        formula += str(i)
        if i > 1:
            formula += " * "
    return str(formula) + " = " + str(result)
print(backward_factorial(5))

print()


