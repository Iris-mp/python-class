def mirror_num_pyramid(n):
    result = ""
    for row in range(1, n+1):
        result += " " * (n-row)
        for num in range(1, row+1):
            result += str(num)
        for num in range (row-1, 0, -1):
            result +=str(num)
        result += "\n"
    return result
